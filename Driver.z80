; For more additional details and explanations, check the Wiki: https://github.com/Franklin0770/Z80-Driver/wiki

	cpu Z80UNDOC
Z80ROM_Start

    phase 0	; Set label addresses to the start of Z80 RAM

	di

	ld	bc,YM2612.CTRL0	; YM2612 bank 1 port
	ld	hl,YM2612.DATA0	; YM2612 data port
	ld	ix,Z80Init	; 14

	if hardwareEarrape
		ld	a,2Ch
		ld	(bc),a
		ld	(hl),20h
	endif
	ld	a,DAC_ENABLE		; DAC enable address
	ld	(bc),a				; switch to DAC enable register
	ld	(hl),80h			; enable DAC
	dec	a					; now a is 2Ah (DAC_IN)
	ld	(bc),a				; switch to DAC data input

Z80Init:
	; Set registers for DAC register set
	ld	bc,YM2612.CTRL0	; 10
	ld	de,YM2612.DATA0	; 10
	ld	hl,SampleBuffer	; 10
	ld	a,DAC_OUT
.routineAddress:
	jp	$				; 10

; At this point, we have register pairs that have different
; purpose: the normal one is for DAC, the shadow one is
; for FM commands.
; BC: PCM buffer index, DE: YM2612 data, HL: YM2612 control
; BC': loop counter, DE': YM2612 control, HL': YM buffer index

Init_DacAndFm:
	exx
FmIterations:
	ld	bc,0
	ld	de,YM2612.CTRL0
	ld	hl,CommandBuffer
	exx
	ld	iyl,DAC_OUT
$$loop_DacAndFm:
	ld	(bc),a
	ld	a,(hl)
	ld	(de),a
	exx		; switch register pair to "FM mode"
	ldi
	ld	a,(hl)
	ld	(de),a
	dec	de
	inc	hl
	exx		; switch register pair to "DAC mode"
	nop
	nop
	inc	hl	; advance DAC buffer pointer
	inc	hl
	ld	a,iyl
	jp	pe,$$loop_DacAndFm	; checks if the P flag is 0

Init_DacOnly:
	ld	(bc),a			; 7
	ld	a,(hl)			; 7
	ld	(de),a			; 7

; --- Restart ---

	inc	hl	; 6
	inc	hl	; 6

	exx

	; Restore JR precision jumps
	ld	hl,0018h	; JR $+2			; 10
	ld	(Loop_DacOnly.jump1),hl			; 16
	ld	(Loop_DacOnly.jump2),hl			; 16
	; Restore JR loop
	ld	hl,0EB18h	; JR Loop_DacOnly	; 10
	ld	(Loop_DacOnly.jump3),hl			; 16

	exx

; --- 98+8 cycles ---

	ld	a,(hl)	; 7
	ld	(de),a	; 7
	inc	hl		; 6
	inc	hl		; 6

	; Get the number of played samples from the
	; buffer index register: HL = (BC-1000h)/2
	ld	b,h		; 4
	ld	c,l		; 4
	res	4,h		; 8
	srl	h		; 8
	rr	l		; 8

	ld	a,r
	ld	(refreshRegister),a

	; Also restore OP code (now it's NOP)
	ld	a,12h								; 7
	ld	(Loop_DacOnly.disable_dac),a	; LD (DE),A	; 13

; This is where most of the debugging values get written to
; RAM, so then the 68k can move them into its own RAM

Loop_DacOnly:
	ld	a,(bc)				; 7
.disable_dac:
	ld	(de),a				; 7
	inc hl					; 6
	ld 	(playedSamples),hl	; 16
.jump1:
	jr	$+2					; 12
	inc	bc					; 6
	inc bc					; 6
	nop
.jump2:
	jr	$+2					; 12
	rept 6
		nop
	endm
.jump3:
	jr	Loop_DacOnly		; 12
	
Init_EndSound:
	ld	(hl),DAC_OUT
	exx
RemainingSamples:
	; The 68k writes the remaining samples here
	ld	bc,0000h
	exx
$$loop_endSound:
	ld	a,(bc)
	ld	(de),a
	rept 10
	nop
	endm
	inc	bc
	inc bc
	cp	0	; just for timing alignment
	cp	0
	exx
	dec	bc
	ld	a,b
	or	c	; check if BC is 0
	exx
	jp	nz,$$loop_endSound

	halt

; ===================================

Init_MixingDacOnly:
	ld	(bc),a		; 7
	ld	a,(hl)		; 7
	inc	hl			; 6
	add	a,(hl)
	rra
	ld	(de),a		; 7
	inc	hl			; 6

	exx

	; Restore JR precision jumps
	ld	hl,0018h	; JR $+2			; 10
	ld	(Mixing_DacOnly.jump1),hl		; 16
	ld	(Mixing_DacOnly.jump2),hl		; 16
	; Restore JR loop
	ld	hl,0EC18h	; JR Loop_DacOnly	; 10
	ld	(Mixing_DacOnly.jump3),hl		; 16

	exx

; --- 98 cycles ---

	ld	(bc),a		; 7
	ld	a,(hl)		; 7
	inc	hl			; 6
	add	a,(hl)
	rra
	ld	(de),a		; 7
	inc	hl			; 6

	; Get the number of played samples from the
	; buffer index register: HL = (BC-1000h)/2
	ld	b,h		; 4
	ld	c,l		; 4
	res	4,h		; 8
	srl	h		; 8
	rr	l		; 8

	inc	bc					; 6

	; Also restore OP code (now it's NOP)
	ld	a,12h								; 7
	ld	(Loop_DacOnly.disable_dac),a	; LD (DE),A	; 13

	ld	a,r					; 9
	ld	(refreshRegister),a	; 13

Mixing_DacOnly:
	ld	a,(hl)				; 7
	inc	hl					; 6
	add a,(hl)				; 7
	rra						; 4
.jump1:
	jr	$+2					; 12
	ld	(de),a				; 7
	ld	(playedSamples),bc	; 20
.jump2:
	jr	$+2					; 12
	inc	hl					; 6
	inc	bc					; 6
	ld	a,0					; 7
	nop						; 4
.jump3:
	jr	Mixing_DacOnly		; 12

; ===================================

Init_CrashDac:
	ld	(hl),DAC_OUT
	ld	hl,900h
$$loop_crashDac:
	ld	a,(hl)			; 7
	ld	(de),a			; 7
	inc	hl				; 6
	ld	b,4				; 7
	djnz $				; 13*3+8
	bit	5,h				; 8
	jp	nz,$$restart	; 10
	inc	ix				; 10
	jp	$$loop_crashDac	; 10
$$restart:	; Restarts the sound chunk playback
	ld	hl,900h			; 10
	jp	$$loop_crashDac	; 10

	dephase	; the rest of the labels are mapped normally

Z80ROM_End

;=================================================================================

	if FALSE	; disable assembly of unused code

	ld	a,(bc)			; 7
	ld	(de),a			; 7

	inc	bc	; 6
	inc	bc	; 6

	ld	a,b

	ld	b,7
	djnz $

	ld	b,a

	nop

Init_DacAndSn:
	exx
SnIterations:
	ld	bc,0
	ld	de,Z80.PSG
	inc	hl
$$loop_DacAndSn:
	exx
	ld	a,(bc)
	ld	(hl),DAC_OUT
	ld	(de),a
	exx
	ld	a,(hl)
	ld	(de),a
	inc	de
	exx
	inc	bc
	inc	bc
	exx
	djnz $$loop_DacAndSn


Init_DacAndEffects:
	ld	b,92
$$loop_DacAndEffects:
	exx
	ld	a,(de)
	ld	(hl),a
	inc	de
	inc	de
	exx
	rept 17
	nop
	endm
	djnz $$loop_DacAndEffects
	; 112 cycles per loop

	ld	iyl,DAC_OUT
$$mixing_DacAndFm:
	ld	(bc),a		; 7
	ld	a,(hl)		; 7
	inc	hl			; 6
	add a,(hl)		; 7
	inc	hl			; 6
	rra				; 4
	ld	(de),a		; 7
	exx				; 4
	ldi				; 16
	ld	a,(hl)		; 7
	ld	(de),a		; 7
	inc	de			; 6
	dec	hl			; 6
	exx				; 4
	ld	a,iyl		; 8
	jp	pe,$$mixing_DacAndFm	; 10

$$unused_DacAndFm2:
	ld	a,(de)
	ld	(hl),a
	inc	de
	inc	de
	exx
	ld	a,(hl)
	ld	(de),a
	inc	e
	inc	hl
	ld	a,(hl)
	ld	(de),a
	dec	de
	inc	hl
	exx
	ex	af,af'
	ld	(bc),a
	ex	af,af'
	djnz $$unused_DacAndFm2

$$unused_DacAndFm3:	; ADPCM attempt
	push hl
	ld	l,(hl)
	ld	h,0
	add	a,(hl)
	pop	hl
	ld	(de),a
	exx
	ldi
	ld	a,(hl)
	ld	(de),a
	ex	af,af'
	dec	e
	inc	hl
	exx
	ld	(bc),a
	ex	af,af'
	jp	pe,$$unused_DacAndFm3

	ld	bc,0
	ld	de,YM2612.CTRL0
	ld	hl,CommandBuffer
Loop_Effects:
	exx
	ld	a,(bc)
	ld	(hl),DAC_OUT
	ld	(de),a
	inc	bc
	inc	bc
	exx
	ld	hl,1232
	ld	a,(hl)
EffectsOffset:
	jp	EffectsTable

Effects
.portamento:
	ld	hl,FREQ
	inc	l
	ld	a,(de)
	ld	(hl),a
	inc	e
	dec	l
	ld	a,b
	or	c
	jp	nz,Loop_Effects

	endif

	cpu 68000