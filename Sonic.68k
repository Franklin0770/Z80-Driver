; Naming conventions:
; variableValue
; CONSTANT_VALUE
; MainRoutineAndLables
; sub_routine

	listing off

stressTest:		equ FALSE	; performs a very heavy and randomized stress test

	include "Constants.asm"
	include "Macros.asm"
	include "Variables.asm"

	listing purecode ; we sure want the listing file, but only the final code in expanded macros

; These switches enable the entire purpose of this driver and modifying them likely makes the playback similar to "traditional" DAC drivers
smoothPlayback:		equ TRUE	; put it to FALSE to prevent 68k output during buffer load
accurateSpeed:		equ TRUE	; put it to FALSE to ignore 68k sample increment calculation
; I often use this switch to test how an ideal and perfect playback would sound, and it's pretty close compared to both 68k and Z80
pureAudio:			equ FALSE	; put it to TRUE to make only the 68k output DAC samples to defy the whole puropose of this audio driver
hardwareEarrape:	equ FALSE	; put this to TRUE to test the true power of the YM2612's DAC output (SW: EXTREMELY LOUD AUDIO)
debugSoundRAM:		equ FALSE

gensFix:		equ FALSE	; use this if you plan to use Gens, since it doesn't emulate the fast Z80 RAM read

bsodCpuLag: 	equ TRUE

ramBufferLoop:	equ FALSE

ROM_Start

	org 0

; ================================================================
; 68000 vectors (with its error code in square brackets)
; ================================================================

		dc.l M68K.STACK			; Initial stack pointer value (SP value)
		dc.l EntryPoint			; Start of program (PC value)
		dc.l BusError			; Bus error							[1]
		dc.l AddressError		; Address error						[2]
		dc.l IllegalInstruction	; Illegal instruction				[3]
		dc.l DivisionByZero		; Division by zero					[4]
		dc.l CHKException		; CHK exception						[5]
		dc.l TRAPVException		; TRAPV exception					[6]
		dc.l PrivilegeViolation	; Privilege violation				[7]
		dc.l TRACEException		; TRACE exception					[8]
		dc.l LineAEmulator		; Line-A emulator					[9]
		dc.l LineFEmulator		; Line-F emulator					[10]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l UnknownError		; Unused (reserved)					[32]
		dc.l SpuriousException	; Spurious exception				[10]
		dc.l InterruptRequest1	; IRQ level 1						[11]
		dc.l InterruptRequest2	; IRQ level 2						[12]
		dc.l InterruptRequest3	; IRQ level 3 						[13]
		dc.l VDP_HBlank			; IRQ level 4 (horizontal retrace)
		dc.l InterruptRequest5	; IRQ level 5						[14]
		dc.l VDP_VBlank			; IRQ level 6 (vertical retrace)
		dc.l InterruptRequest7	; IRQ level 7						[15]
		dc.l TRAPException0		; TRAP #00 exception				[16]
		dc.l TRAPException1		; TRAP #01 exception				[17]
		dc.l TRAPException2		; TRAP #02 exception				[18]
		dc.l TRAPException3		; TRAP #03 exception				[19]
		dc.l TRAPException4		; TRAP #04 exception				[20]
		dc.l TRAPException5		; TRAP #05 exception				[21]
		dc.l TRAPException6		; TRAP #06 exception				[22]
		dc.l TRAPException7		; TRAP #07 exception				[23]
		dc.l TRAPException8		; TRAP #08 exception				[24]
		dc.l TRAPException9		; TRAP #09 exception				[25]
		dc.l TRAPException10	; TRAP #10 exception				[26]
		dc.l TRAPException11	; TRAP #11 exception				[27]
		dc.l TRAPException12	; TRAP #12 exception				[28]
		dc.l TRAPException13	; TRAP #13 exception				[29]
		dc.l TRAPException14	; TRAP #14 exception				[30]
		dc.l TRAPException15	; TRAP #15 exception				[31]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]
		dc.l UnknownError		; Unused (reserved)					[14]

; ===================================================================
; Mega Drive ROM header (reference: https://plutiedev.com/rom-header)
; ===================================================================

		dc.b "SEGA MEGA DRIVE "								; system type - 16 bytes
		dc.b "(C)BRO0 2024.OCT"								; copyright, release year and month (e.g. "(C)SEGA 1991.APR") - 16 bytes
		dc.b "Codename FrankPCM: a high-tech audio driver"	; Domestic name - 48 bytes
		dc.b "     "										; padding
		dc.b "Codename FrankPCM: a high-tech audio driver"	; overseas name - 48 bytes
		dc.b "     "										; padding
		dc.b "GM-12345678-00"								; serial number ("xx-yyyyyyyy-zz") - 14 bytes
		dc.w $0000											; where this ROM gets patched with a 16-bit checksum - 2 bytes
		dc.b "J               "								; device support (e.g. "J" for 3-button controller) - 16 bytes
		dc.l ROM_Start										; start address of ROM - 4 bytes
		dc.l ROM_End										; end address of ROM - 4 bytes
		dc.l $FF0000										; start address of WRAM - 4 bytes
		dc.l $FFFFFF 										; end address of WRAM - 4 bytes
		dc.b "                                                                " ; padding for reserved space - 64 bytes
		dc.b "JUE"											; region support - 16 bytes
		dc.b "             "								; padding for reserved space (you can put a comment if you want!) - 13 bytes

; ========================
; Error handler jump table
; ========================

BusError:
	pea	0
	bra	BsodHandler

AddressError:
	pea	1
	bra	BsodHandler

IllegalInstruction:
	pea	2
	bra	BsodHandler

DivisionByZero:
	pea	3
	bra	BsodHandler
	
CHKException:
	pea	4
	bra	BsodHandler
	
TRAPVException:
	pea	5
	bra	BsodHandler
	
PrivilegeViolation:
	pea	6
	bra	BsodHandler
	
TRACEException:
	pea	7
	bra	BsodHandler

LineAEmulator:
	pea	8
	bra	BsodHandler
	
LineFEmulator:
	pea	9
	bra	BsodHandler
	
SpuriousException:
	pea	10
	bra	BsodHandler

InterruptRequest1:
	pea	11
	bra	BsodHandler

InterruptRequest2:
	pea	12
	bra	BsodHandler

InterruptRequest3:
	pea	13
	bra	BsodHandler
	
InterruptRequest5:
	pea	14
	bra	BsodHandler

InterruptRequest7:
	pea	15
	bra	BsodHandler
	
TRAPException0:
	pea	16
	bra	BsodHandler

TRAPException1:
	pea	17
	bra	BsodHandler

TRAPException2:
	pea	18
	bra	BsodHandler

TRAPException3:
	pea	19
	bra	BsodHandler

TRAPException4:
	pea	20
	bra	BsodHandler

TRAPException5:
	pea	21
	bra	BsodHandler

TRAPException6:
	pea	22
	bra	BsodHandler

TRAPException7:
	pea	23
	bra	BsodHandler

TRAPException8:
	pea	24
	bra	BsodHandler

TRAPException9:
	pea	25
	bra	BsodHandler

TRAPException10:
	pea	26
	bra	BsodHandler

TRAPException11:
	pea	27
	bra	BsodHandler

TRAPException12:
	pea	28
	bra	BsodHandler

TRAPException13:
	pea	29
	bra	BsodHandler

TRAPException14:
	pea	30
	bra	BsodHandler

TRAPException15:
	pea	31
	bra	BsodHandler
	
UnknownError:
	pea	32
	bra	BsodHandler
	
ManualCrash:
	move	sr,REG_DUMP+$44		; dump SR
	move.l	#ManualCrashPc<<8,REG_DUMP+$48
	pea	33
	bra.s	BsodHandler.skip_sr_and_pc

BsodHandler:
	move.w	(4,sp),REG_DUMP+$44		; get SR
	move.l	(12,sp),REG_DUMP+$48	; get PC too
.skip_sr_and_pc:
	lea Z80_CTRL.BUSREQ,a2
	stopZ80 a2
	move #$2700,sr					; disable interrupts
	movem.l	d0-a7,REG_DUMP
	move.l	(sp)+,d7				; get the error code type
	movea.l	usp,a0
	move.l	a0,REG_DUMP+$40			; get USP
	addq.b	#6,REG_PREFIXES+$3F		; add the value back to dumped SP value

	waitZ80

	move.w	#($2000-$900)-1,d0
	movea.l	(sampleIndex),a0
	lea	$900|Z80_CTRL.WRAM,a1
$$copy_samples:
	move.b	(a0)+,(a1)+
	dbf	d0,$$copy_samples

	lea	(Z80Init.routineAddress+1)|Z80_CTRL.WRAM,a0
	move.b	#Init_CrashDac&$FF,(a0)+
	move.b	#Init_CrashDac>>8,(a0)
	lea	Z80Jump3|Z80_CTRL.WRAM,a0
	move.b	#$DD,(a0)+
	move.b	#$E9,(a0)

	startZ80 a2

	if bsodCpuLag
		move.l	#$6FFFF,d2
		bsr.w	CPU_Wait
	endif

	lea VDP.CTRL,a0		; reset A0
	lea VDP.DATA,a1		; reset A1
	if bsodCpuLag
		moveq	#0,d2	; clear slow down timer for CPU_ClearScreen
		moveq	#$7F,d3	; update the slow down timer for CPU_ClearScreen
	endif

; ---------------------------------------------------------------------------
; Subroutine to	clear the screen using CPU and load the font
; ---------------------------------------------------------------------------

	vdpSetColorSpace 2,(a0)
	move.w	#$0000,(a1)

	vdpSetVideoSpace $70,(a0)
	moveq	#(32/4)-1,d0
	move.l	#$22222222,d1
$$fill_tile:
	move.l	d1,(a1)
	dbf d0,$$fill_tile

	vdpSetVideoAddress VDP_VRAM.PLANEA,(a0)
	move.w	#($1000/4)-1,d0	; clear the entire plane A ($1000 bytes)
	move.l	#$00700070,d1
$$clear_screen:
	move.l	d1,(a1)			; clear portion of screen by setting the background tiles
	dbf d0,$$clear_screen	; keep clearing until done

	vdpSetColorSpace 0,(a0)
	move.l	#$0E000EEE,(a1)	; makes the background blue and the font white
	
	vdpSetVideoAddress VDP_VRAM.PLANEA,(a0)
	move.w	#($1000/4)-1,d0
	moveq	#0,d1
$$color_screen:
	move.l	d1,(a1)
	if bsodCpuLag
		move.w	d3,d2		; update the slow down timer for CPU_Wait
		bsr.w	CPU_Wait	; make the slow down effect
	endif
	dbf d0,$$color_screen	; keep clearing until done
	
; Load BSOD font
	vdpSetVideoAddress $0000,(a0)
	move.w	#(PAT_BodyFont.SIZE/4)-1,d0
	lea	PAT_BodyFont,a2
	
$$load_font:
	move.l	(a2)+,(a1)
	dbf d0,$$load_font

	vdpSetVideoAddress $0C00,(a0)
	lea PAT_BodyFont+$200,a2
	move.w	#($140/4)-1,d0

$$load_numbers:
	move.l	(a2)+,(a1)
	dbf d0,$$load_numbers

	lea PAT_BodyFont+$420,a2
	move.w	#($C0/4)-1,d0

$$load_letters:
	move.l	(a2)+,(a1)
	dbf d0,$$load_letters

; ---------------------------------------------------------------------------
; Subroutine to	print on screen the first five strings (messages)
; ---------------------------------------------------------------------------

	lea Messages,a2
	moveq	#5-1,d4		; 5 strings to print (Message0 ~ Code)
$$setup_message:
	move.l	(a2)+,(a0)	; set coordinates
	move.w	(a2)+,d0	; get string length

	if bsodCpuLag
		moveq	#$7F,d3	; update the slow down timer for VDP_PrintText
	endif

	bsr.w	VDP_PrintText
	dbf d4,$$setup_message

; ---------------------------------------------------------------------------
; Subroutine to	print on screen the error code in hexadecimal
; ---------------------------------------------------------------------------

	move.l	#vdpCoordinates(15,5),(a0)
	move.l	#chars('A','A'),(a1)	; print "AA"
	
	moveq	#0,d0
	move.b	d7,d0
	andi.b	#$F0,d0
	lsr.b	#4,d0
	swap	d0
	move.b	d7,d0
	andi.b	#$F,d0

	addi.l	#$00600060,d0
	move.l	d0,(a1)		; print the rest of the error code

; ---------------------------------------------------------------------------
; Subroutine to	print on screen the error code in text
; ---------------------------------------------------------------------------

	lea TextCodes,a3	; load text codes array
	lsl.w	#2,d7
	adda.l	d7,a3
	move.l	(a3)+,d2
	movea.l	d2,a2
	move.l	(a3),d0
	sub.l	d2,d0		; get length
	subq.w	#1,d0
	move.l	#vdpCoordinates(2,6),(a0)

	if bsodCpuLag
		moveq	#$7F,d3	; update the slow down timer for VDP_PrintText
	endif

	bsr.w	VDP_PrintText
	
; ---------------------------------------------------------------------------
; Subroutine to	print on screen the register names (or prefixes)
; ---------------------------------------------------------------------------
	
	lea	Message5,a2		; points to the string address directly
	moveq	#15-1,d0	; this string is 15 characters long
	move.l	#vdpCoordinates(0,9),(a0)
	
	bsr.w	VDP_PrintText

	lea REG_DUMP,a2			; load register dump pointer
	lea	RegisterDumpInformation,a3
	lea	SetupRegisters,a4

SetupRegisters
; Set up data registers
	moveq	#8-1,d0						; 8 registers to write
	moveq	#8-1,d1						; 8 digits to print
	move.l	#vdpCoordinates(2,12),d3	; set on-screen register dump coordinates
	move.l	#('0'-$20)<<8|'d'-$20,d4
	bra.s	PrintRegisters

.address:
	moveq	#7-1,d0						; 7 registers to print
	moveq	#8-1,d1						; 8 digits to print
	move.l	#vdpCoordinates(19,12),d3	; update coordinates
	move.l	#('0'-$20)<<8|'a'-$20,d4
	bra.s	PrintRegisters

.ssp:
	moveq	#1-1,d0						; 1 register to print
	moveq	#8-1,d1						; 8 digits to print
	move.l	#vdpCoordinates(19,22),d3
	move.l	#('p'-$20)<<16|('s'-$20)<<8|'s'-$20,d4
	bra.s	PrintRegisters

.usp:
	moveq	#1-1,d0						; 1 register to print
	move.l	#8-1,d1						; 8 digits to print
	move.l	#vdpCoordinates(19,23),d3
	move.l	#('p'-$20)<<16|('s'-$20)<<8|'u'-$20,d4
	bra.s	PrintRegisters

.sr:
	moveq	#1-1,d0						; 1 register to print
	move.l	#4-1,d1						; 4 digits to print
	move.l	#vdpCoordinates(2,22),d3
	move.l	#('r'-$20)<<8|'s'-$20,d4
	bra.s	PrintRegisters

.pc:
	moveq	#1-1,d0						; 1 register to print
	moveq	#6-1,d1						; 6 digits to print
	move.l	#vdpCoordinates(2,23),d3
	move.l	#('c'-$20)<<8|'p'-$20,d4
	bra.s	PrintRegisters

.halt:
	stop #$2700		; halt the CPU indefinitely

;============================================================================

; Print a register (prefix + value)

PrintRegisters:
	move.l	d3,(a0)			; update the plane coordinates

; Print on screen the register prefix
	move.l	d4,d5
	moveq	#0,d6
$$print_prefix:
	move.b	d5,d6
	move.w	d6,(a1)			; print register number

	if bsodCpuLag
		moveq	#$7F,d2		; update the slow down timer
		bsr.s	CPU_Wait	; a bit of lag
	endif

	lsr.l	#8,d5			; next character (also clear the one we just printed)
	bne.s	$$print_prefix	; if D5 is 0 there are no more characters to print

	move.w	#':'-$20,(a1)
	move.l	#chars('0','x'),(a1)
		
; Print on screen the register digits from dump
    move.w	d1,d5			; update the digit counter
	move.l	(a2)+,d6		; get the register dumped value
	moveq	#0,d7
$$print_value:
	rol.l	#4,d6			; rotate the digits on the left
	move.b	d6,d7			; move the digits in ascending order to d5
	andi.b	#$F,d7			; remove the other digit
	addi.w	#$60,d7
	
	move.w	d7,(a1)			; update the plane A

	if bsodCpuLag
		moveq	#$7F,d2		; update the slow down timer
		bsr.s	CPU_Wait	; a bit of lag
	endif
	
	dbf d5,$$print_value	; loop until printed all digits

	addi.l	#$800000,d3		; new line by adding coordinates
	addi.w	#$100,d4		; increment register number character

	dbf d0,PrintRegisters

	move.w	(a3)+,d0
	jmp (a4,d0.w)
	
; ---------------------------------------------------------------------------
; Subroutine to	draw text on screen (a2: string pointer, d0: length)
; ---------------------------------------------------------------------------

VDP_PrintText:
	moveq	#0,d1		; clear d1
$$update_display:
	move.b 	(a2)+,d1	; move character to d1
	move.w 	d1,(a1)		; no flip, palette 0, no priority
	if bsodCpuLag=1
		move.l	d3,d2		; update the slow down timer for CPU_Wait
		bsr.s	CPU_Wait	; make the slow down effect
	endif
	dbf	d0,$$update_display
	rts

	if bsodCpuLag

; ---------------------------------------------------------------------------
; Subroutine to	hang the CPU for a given time (d2: timer)
; ---------------------------------------------------------------------------

CPU_Wait:
;	movea.l	d2,a6
;	move.b	(randomByte),d2
;	lsl.l	#1,d2
;	adda.l	d2,a6
;	move.l	a6,d2

$$wait:	
	subi.l	#1,d2		; purposefully using a slower instruction
	bne.s	CPU_Wait	; wait until done (DBF subs only word-wise, which is not suitable)
	rts

	endif

; ============================================================================

VDP_VBlank:
	tst.b	(shouldPause)
	beq.s	$$skip_pause
	clr.w	(z80Samples)
	stopZ80
	rte
$$skip_pause:
	vdpSetColorSpace 0, VDP.CTRL
	move.w	#$000E,VDP.DATA
	; DPLC loading queues
	if stressTest
		moveq	#$5A,d0
		move.b	(randomByte),d0
		lsl.w	#6,d0
		dbf	d0,*
	endif
; --- Variable cycles ---
	stopZ80									; initiate Z80 stop. 20
	lea Z80_CTRL.BUSREQ,a0					; 8
	lea	playedSamples+1|Z80_CTRL.WRAM,a1	; 8
	movea.l	(sampleIndex),a5				; 16
	lea	YM2612_68K.DATA0,a6					; 8
	moveq	#0,d0							; 4
	waitZ80	d0,a0							; 12 (at best)
	
	if ~~gensFix
		move.w	(a1),d0		; get high byte of playedSamples. 8
	else
		move.b	(a1),d0
		lsl.w	#8,d0
	endif

	move.b	-(a1),d0		; get lower byte of playedSamples. 8
	adda.l	d0,a5			; 8

	if smoothPlayback
		move.b	(a5)+,(a6)	; output sample. 12
	elseif accurateSpeed
		addq.l	#1,a5
		nop
	endif

	move.w	d0,(z80Samples)	; 12
	movea.l	a5,a0	; 4

	if accurateSpeed
		addaq	BUFFER_ITERATIONS+4,a0	; sample index after 68k routine execution (A5 at the end, basically). 8
	endif

	move.l	a0,d4	; D4 is now the updated sample index. 4

	lea	SampleBuffer|Z80_CTRL.WRAM,a1	; 8

	btst	#0,d4				; is the sample index even? 6
	beq.s	$$skip_alignment	; if yes, skip the alignment. 10
	move.b	(a0)+,(a1)			; if not, the 68k will crash, so we avoid it. 12
	addq.l	#2,a1				; 8
	move.l	a0,d4	; D4 is now the updated sample index. 4
$$skip_alignment:
	rept 4
	nop				; 4*4
	endm

	moveq	#BUFFER_ITERATIONS-1,d1
	;moveq	#$0,d2

; We have to assume that every time the 68k writes on Z80 RAM there's a one-cycle penalty.
; This is due to the different clock phases of the 68k (7.67 MHz) and Z80 buses (3.58 MHz).

$$buffer_loop:
	if smoothPlayback
		move.b	(a5)+,(a6)	; output sample. 12
	elseif accurateSpeed
		addq.l	#1,a5
		nop
	endif

	move.l	(a0)+,d0		; 12
	movep.l d0,(0,a1)		; ~29

	move.l	(a0)+,d0		; 12
	movep.l	d0,(8,a1)		; ~29

	move.l	(a0)+,d0		; 12
	movep.l	d0,(16,a1)		; ~29

	move.l	(a0)+,d0		; 12
	movep.l	d0,(24,a1)		; ~29

	move.l	(a0)+,d0		; 12
	movep.l	d0,(32,a1)		; ~29

	adda.w	#40,a1			; 12

	dbf d1,$$buffer_loop	; 10

	if smoothPlayback
		move.b	(a5)+,(a6)	; output sample. 12
	elseif accurateSpeed
		addq.l	#1,a5
		nop
	endif

	tst.b	(noMoreFm)
	bne.s	$$skip_remainder

	moveq	#0,d1
	lea	FmControl,a0
	lea	CommandBuffer|Z80_CTRL.WRAM,a2
	move.b	(a0)+,d1
	move.b	d1,((FmIterations+1)|Z80_CTRL.WRAM)
	move.l	d1,d3
	lsr.b	#2,d1
	subq.b	#1,d1
	move.l	d1,d2
	andi.l	#$8-1,d3

$$load_fm_ctrl:
	move.l	(a0)+,d0
	movep.l	d0,(a2)
	addq.l	#8,a2
	dbf d1,$$load_fm_ctrl

	lea	FmData,a1
	lea	(CommandBuffer+1)|Z80_CTRL.WRAM,a3

$$load_fm_data:
	move.l	(a1)+,d0
	movep.l	d0,(a3)
	addq.l	#8,a3
	dbf d2,$$load_fm_data

	subq.b	#1,d3
	bls.s	$$skip_remainder

$$load_remainder:
	move.b	(a0)+,(a2)+
	move.b	(a1)+,(a2)+
	dbf d3,$$load_remainder

$$skip_remainder:
	move.b	(a5)+,d0
	move.b	d0,(a6)
	move.b	d0,(lastSample)

	if smoothPlayback
		move.b	(a5)+,(a6)	; output sample. 12
	elseif accurateSpeed
		addq.l	#1,a5
		nop
	endif

	move.l	#Music.end,d0	; 12
	sub.l	d4,d0			; 8
	moveq	#0,d1			; 4
	move.w	(z80Samples),d1	; 12
	sub.l	d1,d0	; is the audio about to end (ends on Z80 buffer)? 8
	bpl.s	SkipTracking		; 10 cycles on branch, 8 cycles no branch

; Z80 playback with sample tracking routine to stop at the right time
	lea	(Z80Init.routineAddress+1)|Z80_CTRL.WRAM,a0	; 8
	move.b	#Init_EndSound&$FF,(a0)+	; 12
	move.b	#Init_EndSound>>8,(a0)		; 12
	neg.w	d0	; get the absolute value of the remaining samples to play
	lea	(RemainingSamples+1)|Z80_CTRL.WRAM,a0	; 8
	move.b	d0,(a0)+							; 8
	lsr.w	#8,d0								; 22
	move.b	d0,(a0)								; 8
	st	(shouldStop)							; 16
	bra.s	UpdateRoutine						; 10

SkipTracking:
	tst.b	(noMoreFm)								; 12
	bne.s	$$skip_sound							; 10
	lea	(Z80Init.routineAddress+1)|Z80_CTRL.WRAM,a0	; 8
	move.b	#Init_DacAndFm&$FF,(a0)+				; 12
	move.b	#Init_DacAndFm>>8,(a0)					; 12
	bra.s	UpdateRoutine							; 10

$$skip_sound:
	lea	(Z80Init.routineAddress+1)|Z80_CTRL.WRAM,a0	; 8
	move.b	#Init_DacOnly&$FF,(a0)+					; 12
	move.b	#Init_DacOnly>>8,(a0)					; 12

UpdateRoutine:
	; Replaces JR jumps with JP (IX)
	move.b	#$DD,d0					; 8
	move.b	#$E9,d1					; 8
	lea	Z80Jump1|Z80_CTRL.WRAM,a0	; 8
	lea	Z80Jump2|Z80_CTRL.WRAM,a1	; 8
	lea	Z80Jump3|Z80_CTRL.WRAM,a2	; 8
	move.b	d0,(a0)+				; 8
	move.b	d1,(a0)					; 8
	move.b	d0,(a1)+				; 8
	move.b	d1,(a1)					; 8
	move.b	d0,(a2)+				; 8
	move.b	d1,(a2)					; 8

	clr.b	(DisableDacInjection|Z80_CTRL.WRAM)				; 16
	nop

	if smoothPlayback
		move.b	(a5)+,(a6)	; output sample. 12
	elseif accurateSpeed
		addq.l	#1,a5
		nop
	endif

	move.b	(refreshRegister|Z80_CTRL.WRAM),(randomByte)	; 16

	startZ80	; restart Z80. 16

	move.l	d4,(sampleIndex)	; 16
	st	(noMoreFm)				; 16

	vdpSetColorSpace 0, VDP.CTRL	; 24
	move.w	#$0000,VDP.DATA			; 16

	rte

; ==========================

; Horizontal interrupt
VDP_HBlank:
	rte

; ==========================

EntryPoint:
	move.b	(REG.VERSION),d0
	andi.b	#$F,d0	; check if the console has TMSS or not
	beq.s	$$skip_tmss
	move.l	#"SEGA",(REG.TMSS)
$$skip_tmss:

; ============================
; VDP initialization and setup
; ============================

; VDP setup reference: https://plutiedev.com/vdp-setup

	lea VDP.CTRL,a0
	lea	VDP.DATA,a1

	tst.w 	(a0) ; testing the VDP control port safely resets it
	
; Register reference: https://plutiedev.com/vdp-registers

	move.l  #(VDP_REG.MODE1|%00000100)<<16|(VDP_REG.MODE2|%01110100),(a0)	; mode register #1 and Mode register #2
	move.l  #(VDP_REG.MODE3|%00000000)<<16|(VDP_REG.MODE4|%10000001),(a0)	; mode register #3 and Mode Register #4
    
; Planes reference: https://segaretro.org/Sega_Mega_Drive/Planes

 	move.l  #(VDP_REG.PLANEA|(VDP_VRAM.PLANEA>>10))<<16|(VDP_REG.PLANEB|(VDP_VRAM.PLANEB>>13)),(a0)	; plane A and Plane B address
	move.l  #(VDP_REG.SPRITE|(VDP_VRAM.SPRITE>>9))<<16|(VDP_REG.WINDOW|(VDP_VRAM.WINDOW>>10)),(a0)	; sprite and Window address
	move.w  #VDP_REG.HSCROLL|(VDP_VRAM.HSCROLL>>10),(a0)											; horizontal scroll address
    
	move.l  #(VDP_REG.WINX|$00)<<16|(VDP_REG.WINY|$00),(a0)			; window X split and Window Y split
	move.l  #(VDP_REG.SIZE|%00000001)<<16|(VDP_REG.BGCOL|$00),(a0)	; tilemap size and Background color
	move.l  #(VDP_REG.INCR|$02)<<16|(VDP_REG.HRATE|$FF),(a0)		; autoincrement and HBlank IRQ rate

	moveq 	#$40,d0
	move.b	d0,(JOY1.CTRL)	; initialize controller ports
	move.b	d0,(JOY1.DATA)

; Initialization code to set up screen, reset variables and processors

	dma68kToVDP PAT_BodyFont, $0000, PAT_BodyFont.SIZE, VDP_CMD.VRAM, FALSE, (a0), (a1)	; load default font
	dma68kToVDP PAT_BodyFont+$200, $0C00, $140, VDP_CMD.VRAM, FALSE, (a0), (a1)			; load separate numbers used for value printing
	dma68kToVDP PAT_BodyFont+$420, $0C00+$140, $C0, VDP_CMD.VRAM, FALSE, (a0), (a1)		; load rest of the hexadecimal digits

	vdpSetColorSpace 0,(a0)	; set write address to palette line 0, color 0
	move.l	#$0000EEEE,(a1)	; black and white

	dmaFillVRAM $00, VDP_VRAM.PLANEA, $1000, (a0), (a1) ; clears characters at every soft reset

	move.w	(a0),d0
	btst	#$0,d0
	bne.w	PalScreen

Init_Driver:
; Prints static text on screen
	lea	StaticText,a2
	moveq	#14-1,d0	; number of strings to print
$$next_text:
	moveq	#0,d2		; no flip, palette 0, low priority for the next tilemap values
	move.l	(a2)+,(a0)	; set coordinates
	move.w	(a2)+,d1	; get string length
$$print_text:
	move.b	(a2)+,d2	; get character
	move.w	d2,(a1)		; put it to the tilemap
	dbf d1,$$print_text	; next character
	dbf d0,$$next_text	; next string

	lea Z80_CTRL.BUSREQ,a3
	lea Z80_CTRL.RESET,a2

	move.w	#$100,d2	; assert, stop
	moveq	#0,d1		; deassert, start

	assertZ80Reset d1,a2	; assert reset
	stopZ80 d2,a3			; request bus
	deassertZ80Reset d2,a2	; release reset
	; We can do more stuff while the Z80 is theoretically stopping
	move.l 	#Music,(sampleIndex)
	move.w	#BUFFER_ITERATIONS+3,(m68kSamples)
	clr.l 	(frameCount)
	clr.w	(SamplesEvery15Fr)
	clr.b	(FrameCounter15)
	lea playedSamples|Z80_CTRL.WRAM,a0
	clr.b	(a0)+	; only a byte at time when writing to Z80 WRAM
	clr.b	(a0)
	sf	(shouldStop)
	st	(noMoreFm)
	sf	(shouldPause)
	move.w	#$3FF,(controllerStatus)	; set all buttons to 1 (since the port is pulled-up)

	lea Z80ROM_Start,a0
	lea Z80_CTRL.WRAM,a1
	move.w	#(Z80ROM_End-Z80ROM_Start)-1,d0

$$copy_program:
	move.b	(a0)+,(a1)+
	dbf d0,$$copy_program

; Fills entire buffer with $80s so then it won't sound awful when it overruns
	lea	Z80_CTRL.WRAM|$1000,a0
	move.w	#$500,d0
	move.b	#$80,d1
$$fill_buffer:
	move.b	d1,(a0)+
	dbf	d0,$$fill_buffer


	if debugSoundRAM
		lea	SampleBuffer|Z80_CTRL.WRAM,a0
		move.w	#$C00,d0
		moveq	#0,d1

	$$copy_data:
		move.b	d1,(a0)+
		addq.b	#1,d1	; fill sample buffer with increasing bytes
		dbf d0,$$copy_data
	endif

	assertZ80Reset d2,a2	; assert reset

	moveq	#20,d0
    dbf	d0,*	; wait for the YM2612 to wake up

	deassertZ80Reset d2,a2	; release reset

	if pureAudio
		loopTest1 52
	endif

	if ramBufferLoop
	move.w	#(loopRamTest.end-loopRamTest)/4,d0
	lea	loopRamTest,a0
	lea	$FFA000,a1

$$load_code:
	move.l	(a0)+,(a1)+
	dbf	d0,$$load_code

	jmp	$FFA000
	endif

	;loopTest2

	startZ80 a3	; release bus
	bra.s	UpdateButtons

;=================================================================================
; Code that runs every frame

ReadJoypad:
	lea	JOY1.DATA,a0
	move.b 	#$40,(a0)
	lea	controllerStatus,a1
	moveq	#0,d0
	moveq	#$3C,d2 ; wait for the bus to get the controller state
	move.b	(a0),d0

	move.b 	#$00,(a0)
	and.b	d2,d0	; AND the redundant bits (L and R) with $3C
	lsl.w	#4,d0	; shift the unique bits
	or.b	(a0),d0
	; Remember that bits here are inverted for performance
	; 0: pressed, 1: not pressed
	move.w	(a1),d1	; get previous joypad state
	move.w	d0,(a1)	; update joypad state
	
	move.w	d0,d2
	move.w	d1,d3

	not.w	d0
	and.w   d0,d1	; just pressed = ~now & before

	not.w	d3
	and.w	d3,d2	; just released = now & ~before
	rts

UpdateButtons:
	bsr.s	ReadJoypad
; D0: held buttons, D1: pressed buttons
	btst	#JOY.A,d1
	bne.w	PlayNote
	btst	#JOY.B,d0
	bne.w	PlayNote
	btst 	#JOY.C,d1
	bne.w	RestartSample
	btst	#JOY.R,d1
	bne.w	SkipForward
	btst	#JOY.L,d1
	bne.w	SkipBackward
	btst	#JOY.U,d1
	bne.w	JumpForward
	btst	#JOY.D,d1
	bne.w	JumpBackward
	btst	#JOY.START,d2
	bne.w	PauseOrResume
	btst	#JOY.START,d0
	bne.w	StartHoldHandler

	clr.w	(startHoldFrames)

UpdateDebugger:
; Update samples per second (sample rate) every 15 frames
	lea SamplesEvery15Fr,a0
	lea FrameCounter15,a1

	move.w	(m68kSamples),d0
	move.w	(z80Samples),d1

	add.w	d0,d1

	add.w	(a0),d1
	move.w	d1,(a0)

	move.b	(a1),d0
	addq.b	#1,d0
	cmpi.b	#15,d0
	ble.s	+
	moveq	#0,d0
	move.w	d0,(a0)
	lsl.w	#2,d1
	move.w	d1,(sampleRate)
+
	move.b	d0,(a1)

; Prints dynamic RAM values that get updated each frame next to static text
.init:
	moveq	#0,d2	; no flip, palette 0, low priority for the next tilemap values
	moveq	#7-1,d3	; number of values to print
	lea	VDP.CTRL,a0
	lea	VDP.DATA,a1
	lea	ValueInformation,a2
.loop:
	movea.l	(a2)+,a3	; variable address
	move.l	(a2)+,(a0)	; VDP coordinates
	move.w	#$0004,(a1)	; print "$"
	move.w	(a2)+,d0	; jump offset
.base:
	jmp (pc,d0.w)	; jump to corresponding routine based on value size

PrintByte:
	moveq	#2-1,d0	; number of digits to print (a byte has two digits)
	move.b	(a3),d1	; get the RAM value of interest
$$print_byte:
	rol.b	#4,d1				; rotate each digit
	move.b	d1,d2				; back up a byte to D2
	andi.b	#$0F,d2				; get only 1 digit
	addi.w	#$60,d2				; apply the VRAM font offset
	move.w	d2,(a1)				; update tilemap with no flip, palette 0, low priority
	dbf d0,$$print_byte			; next value digit
	dbf d3,UpdateDebugger.loop	; next RAM value
	bra.s	WaitInterrupt		; continue (avoiding fallthrough)

PrintWord:
	moveq	#4-1,d0
	move.w	(a3),d1
$$print_word:
	rol.w	#4,d1
	move.b	d1,d2
	andi.b	#$0F,d2
	addi.w	#$60,d2
	move.w	d2,(a1)
	dbf d0,$$print_word
	dbf d3,UpdateDebugger.loop
	bra.s	WaitInterrupt

PrintLong:
	moveq	#8-1,d0
	move.l	(a3),d1
$$print_long:
	rol.l	#4,d1
	move.b	d1,d2
	andi.b	#$0F,d2
	addi.w	#$60,d2
	move.w	d2,(a1)
	dbf d0,$$print_long
	dbf d3,UpdateDebugger.loop

WaitInterrupt:
	;moveq	#0,d0
	;move.w	(z80Samples),d0
	;chk #$21C,d0			; check if there's a buffer overrun
	stop	#$2500			; wait until next frame
	tst.b	(shouldStop)	; is the audio ended?
	bne.w	DisableCpu		; if yes, stop the CPU
	addq.l	#1,(frameCount)	; update frame counter
	bra.w	UpdateButtons	; go back to check buttons
PlayNote:
	sf	(noMoreFm)
	bra.w	UpdateDebugger

RestartSample:
	move.l	#Music,(sampleIndex)	; reset sample index
	bra.w	UpdateDebugger

SkipForward:
	move.l	(sampleIndex),d0
	add.l	#$10000,d0
	bra.s	IsOutOfBound

SkipBackward:
	move.l	(sampleIndex),d0
	sub.l	#$10000,d0
	bra.s	IsOutOfBound

JumpForward:
	move.l	(sampleIndex),d0
	add.l	#$100000,d0
	bra.s	IsOutOfBound

JumpBackward:
	move.l	(sampleIndex),d0
	sub.l	#$100000,d0

; Checks if skipping forward or backward makes
; the index go out of bound. If it does, the
; button press will be ignored.
IsOutOfBound:
	cmp.l	#Music.end,d0
; Ignore press if the sample index is too big (over ROM size limit)
	bhi.w	UpdateDebugger
	cmp.l	#Music,d0
; Ignore press if the sample index is too small (on code and assets)
	blo.w	UpdateDebugger
	move.l	d0,(sampleIndex)	; apply the result if no boundaries are hit
	bra.w	UpdateDebugger

PauseOrResume:
	moveq	#0,d1
	lea VDP.CTRL,a0
	lea VDP.DATA,a1
	lea	(PauseMessage),a2
	move.l	(a2)+,(a0)
	move.w	(a2)+,d0
	not.b	(shouldPause)
	bne.s	$$print_text
; Clear pause text
$$clear_text:
	move.w	d1,(a1)
	dbf d0,$$clear_text
	bra.w	UpdateDebugger
; Print pause text
$$print_text:
	move.b	(a2)+,d1
	move.w	d1,(a1)
	dbf d0,$$print_text
	bra.w	UpdateDebugger

StartHoldHandler:
	move.w	(startHoldFrames),d0
	addq.w	#1,d0
	cmpi.w	#60*5,d0
ManualCrashPc:
	bhs.l	ManualCrash
	move.w	d0,(startHoldFrames)
	bra.w	UpdateDebugger

DisableCpu:
	lea VDP.CTRL,a0
	lea VDP.DATA,a1
	lea	HaltMessage,a2
	moveq	#2-1,d1
$$next_text:
	moveq	#0,d2
	move.l	(a2)+,(a0)
	move.w	(a2)+,d0
$$print_text:
	move.b	(a2)+,d2
	move.w	d2,(a1)
	dbf d0,$$print_text
	dbf d1,$$next_text

	stop	#$2700	; halt indefinitely

PalScreen:
	st	(shouldPause)

	lea	PalWarning,a2
	moveq	#5-1,d0		; number of strings to print
$$next_text:
	moveq	#0,d2		; no flip, palette 0, low priority for the next tilemap values
	move.l	(a2)+,(a0)	; set coordinates
	move.w	(a2)+,d1	; get string length
$$print_text1:
	move.b	(a2)+,d2		; get character
	move.w	d2,(a1)			; put it to the tilemap
	dbf d1,$$print_text1	; next character
	dbf d0,$$next_text		; next string

	move.w	#$00FF,d0

$$wait:
	stop #$2500
	dbf	d0,$$wait

	move.l	(a2)+,(a0)	; set coordinates
	move.w	(a2)+,d0	; get string length

$$print_text2:
	move.b	(a2)+,d2		; get character
	move.w	d2,(a1)			; put it to the tilemap
	dbf d0,$$print_text2	; next character

$$check_controller:
	stop #$2500
	bsr.w	ReadJoypad
	cmpi.w	#$FF1C,d0
	bne.w	$$check_controller

	lea VDP.CTRL,a0
	lea	VDP.DATA,a1
	dmaFillVRAM $00, VDP_VRAM.PLANEA, $1000, (a0), (a1)
	bra.w	Init_Driver

;=================================================================================

; Assets section
	if ramBufferLoop
loopRamTest
	moveq	#0,d2

	lea	$FFF000,a0
	lea	$0000|Z80_CTRL.WRAM,a1
	lea	(YM2612.CTRL0|Z80_CTRL.WRAM),a2
	lea	Music,a5
	lea	(YM2612.DATA0|Z80_CTRL.WRAM),a6

	move.b	#DAC_ENABLE,(a2)
	move.b	#$80,(a6)
	move.b	#DAC_OUT,(a2)

$$loop:
	move.b	(a5)+,(a6)	; output sample. 12

	move.l	(a0),d0
	movep.l d0,(0,a1)

	move.l	(a0),d0
	movep.l	d0,(8,a1)

	move.l	(a0),d0
	movep.l	d0,(16,a1)

	move.l	(a0),d0
	movep.l	d0,(24,a1)

	move.l	(a0),d0
	movep.l	d0,(32,a1)

	rept 3
	nop
	endm

	bra.s	$$loop
loopRamTest.end
	endif

	include "Strings.asm"
	
	align 2
	listing off
PAT_BodyFont:	include "Body Font.asm"
.SIZE:	equ 96*32

	listing on
	include "Driver.z80"

	padding off
	odd
FmControl
	dc.b	29

	dc.b	YMctrl_ARandRS(CH1_4,OP1)
	dc.b	YMctrl_DRandAM(CH1_4,OP1)
	dc.b	YMctrl_RRandSL(CH1_4,OP1)
	dc.b	YMctrl_SR(CH1_4,OP1)
	dc.b	YMctrl_MULandDT(CH1_4,OP1)
	dc.b	YMctrl_TL(CH1_4,OP1)
	
	dc.b	YMctrl_ARandRS(CH1_4,OP2)
	dc.b	YMctrl_DRandAM(CH1_4,OP2)
	dc.b	YMctrl_RRandSL(CH1_4,OP2)
	dc.b	YMctrl_SR(CH1_4,OP2)
	dc.b	YMctrl_MULandDT(CH1_4,OP2)
	dc.b	YMctrl_TL(CH1_4,OP2)

	dc.b	YMctrl_ARandRS(CH1_4,OP3)
	dc.b	YMctrl_DRandAM(CH1_4,OP3)
	dc.b	YMctrl_RRandSL(CH1_4,OP3)
	dc.b	YMctrl_SR(CH1_4,OP3)
	dc.b	YMctrl_MULandDT(CH1_4,OP3)
	dc.b	YMctrl_TL(CH1_4,OP3)

	dc.b	YMctrl_ARandRS(CH1_4,OP4)
	dc.b	YMctrl_DRandAM(CH1_4,OP4)
	dc.b	YMctrl_RRandSL(CH1_4,OP4)
	dc.b	YMctrl_SR(CH1_4,OP4)
	dc.b	YMctrl_MULandDT(CH1_4,OP4)
	dc.b	YMctrl_TL(CH1_4,OP4)

	dc.b	YMctrl_ALandFB(CH1_4)
	dc.b 	$28	; Key-On and Key-Off
	dc.w	YMctrl_FRandBL(CH1_4)
	dc.b 	$28

	align 2

FmData
	dc.b	YMdata_ARandRS(31,0)
	dc.b	YMdata_DRandAM(8,0)
	dc.b	YMdata_RRandSL(3,15)
	dc.b	YMdata_SR(0)
	dc.b	YMdata_MULandDT(5,2)
	dc.b	YMdata_TL(42)

	dc.b	YMdata_ARandRS(31,0)
	dc.b	YMdata_DRandAM(10,0)
	dc.b	YMdata_RRandSL(4,15)
	dc.b	YMdata_SR(0)
	dc.b	YMdata_MULandDT(1,7)
	dc.b	YMdata_TL(18)

	dc.b	YMdata_ARandRS(31,0)
	dc.b	YMdata_DRandAM(4,0)
	dc.b	YMdata_RRandSL(1,11)
	dc.b	YMdata_SR(0)
	dc.b	YMdata_MULandDT(1,2)
	dc.b	YMdata_TL(48)

	dc.b	YMdata_ARandRS(31,0)
	dc.b	YMdata_DRandAM(9,0)
	dc.b	YMdata_RRandSL(9,15)
	dc.b	YMdata_SR(0)
	dc.b	YMdata_MULandDT(1,7)
	dc.b	YMdata_TL(0)

	dc.b	YMdata_ALGandFB(0,4)
	dc.b	0
	dc.w	YMdata_FRandBL(644,4)
	dc.b	%11110000

	align 2
Music
	if ~~hardwareEarrape
	;binclude "continuity_test.bin" ; test with increasing bytes to make sure no samples get skipped
	;binclude "sinewave.bin"

	;binclude "24. Time Rift Shift ~ Vs. Metal Sonic.raw" ; great music right here
	;binclude "Don't Stand So Close To Me.raw" ; another banger
	;binclude "Spirits In The Material World.raw" ; this is a good one
	;binclude "Every Little Thing She Does Is Magic.raw" ; another nice one
	;binclude "Ki.raw" ; minceraft
	;binclude "Haunt Muskie.raw" ; Hype, my friends
	;binclude "Droopy likes your face.raw" ; underrated
	;binclude "Chris.raw" ; Chris
	;binclude "Magnetic Circuit.raw" ; Notch what are you doing
	;binclude "Lava Chicken.raw" ; Minecraft?
	;binclude "Bad (2012 Remaster).raw" ; bad in a good way
	;binclude "Smooth Criminal.raw" ; Annie are you okay
	;binclude "Billie Jean.raw" ; Billie Jean
	;binclude "P.Y.T. (Pretty Young Thing).raw"
	;binclude "Last Surprise.raw" ; a good discovery
	;binclude "Roxanne.raw" ; ROOOOOOOxanne
	binclude "DARE.raw" ; It's coming up
	;binclude "music.pcm" ; let's not talk about this
	;binclude "My Summary.raw"
	else
	binclude "Minecraft Earrape.raw"
	endif
.end
; Fill value in Mega Driven Environment is set to 80, 
; so it'll fill the rest of the ROM with this byte,
; which is silence, smoothing out stopping imprecision.
	org	$3FFFFF
	dc.b $80
ROM_End